        "import re\n",
        "import string\n",
        "import pandas as pd\n",
        "from IPython.display import display\n",
        "\n",
        "# Membaca file dataset csv yang benar-benar tersedia di environment\n",
        "df = pd.read_csv(\n",
        "    \"/content/dataset analisis sentimen.csv\",\n",
        "    encoding=\"utf-8-sig\"\n",
        ")\n",
        "\n",
        "# Tampilkan kolom yang tersedia untuk memastikan kolom teks yang benar\n",
        "print(\"Available columns in the DataFrame:\")\n",
        "print(df.columns)\n",
        "\n",
        "# pastikan kolom teks yang benar sesuai isi dataset CSV Anda\n",
        "text_col = 'text komentar gabungan medsos + gfrom'\n",
        "\n",
        "if 'id' not in df.columns:\n",
        "    df['id'] = df.index\n",
        "\n",
        "# hapus NaN & kosong\n",
        "df = df.dropna(subset=[text_col])\n",
        "df = df[df[text_col].astype(str).str.strip() != '']\n",
        "\n",
        "# hapus duplikat (kunci pembanding dibuat huruf kecil agar duplikat yang\n",
        "# hanya berbeda kapitalisasi tetap terdeteksi, teks aslinya tidak diubah)\n",
        "kunci_duplikat = df[text_col].astype(str).str.lower().str.strip()\n",
        "df = df[~kunci_duplikat.duplicated(keep=\"first\")].copy()\n",
        "jumlah_sebelum_cleaning = len(df)\n",
        "\n",
        "def cleaning_text_safe(text):\n",
        "\n",
        "    if pd.isna(text) or not str(text).strip():\n",
        "        return \"\"\n",
        "    text = str(text)\n",
        "\n",
        "    # Hapus karakter tak terbaca (non-printable) dan simbol rusak akibat kesalahan enkoding\n",
        "    text = re.sub(r\"[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f\\u200b-\\u200f\\ufeff]\", \"\", text)\n",
        "    for rusak in [\"ï»¿\", \"â€™\", \"â€œ\", \"â€\", \"Ã©\", \"â²\", \"Â\"]:\n",
        "        text = text.replace(rusak, \"\")\n",
        "\n",
        "    # Perbaikan data: normalisasi tawa versi lama sempat mengubah 'lolos' menjadi 'hahaos'\n",
        "    text = re.sub(r\"\\bhahaos\", \"lolos\", text)\n",
        "\n",
        "    # Ganti mention dengan 'user' & hapus tanda # (kata hashtag tetap disimpan)\n",
        "    text = re.sub(r'@\\w+', 'user', text)\n",
        "    text = re.sub(r'#', '', text)\n",
        "\n",
        "    # Ganti URL\n",
        "    text = re.sub(r\"(https?\\\\ +|www\\\\ +)\", 'url', text, flags=re.IGNORECASE)\n",
        "\n",
        "    # Tangani tanda hubung terlebih dahulu\n",
        "    text = re.sub(r'(?<=\\d)- (?=\\d)', ' - ', text)\n",
        "    text = re.sub(r'-(?!\\d)', ' ', text)\n",
        "\n",
        "    # Hapus tanda baca umum, tapi biarkan ! - . , (tanda tanya dihapus)\n",
        "    tanda_penting = \"!-. ,\"\n",
        "    tanda_baca = ''.join(ch for ch in string.punctuation if ch not in tanda_penting)\n",
        "    for symbol in ['/', '&', '_', '|']:\n",
        "        text = text.replace(symbol, ' ')\n",
        "\n",
        "    text = text.translate(str.maketrans(\"\", \"\", tanda_baca))\n",
        "\n",
        "    # Hapus karakter aneh\n",
        "    text = re.sub(r\"[^\\w\\s,\\.\\-!…]\", \" \", text)\n",
        "\n",
        "    # Hapus emoji\n",
        "    emoji_pattern = re.compile(\n",
        "        r\"[\"\n",
        "        u\"\\U0001F600-\\U0001F64F\"\n",
        "        u\"\\U0001F300-\\U0001F5FF\"\n",
        "        u\"\\U0001F680-\\U0001F6FF\"\n",
        "        u\"\\U0001F1E0-\\U0001F1FF\"\n",
        "        u\"\\U00002500-\\U00002BEF\"\n",
        "        u\"\\U00002702-\\U000027B0\"\n",
        "        u\"\\U0001F900-\\U0001F9FF\"\n",
        "        u\"\\U0001FA70-\\U0001FAFF\"\n",
        "        u\"\\U00002600-\\U000026FF\"\n",
        "        u\"\\U00002700-\\U000027BF\"\n",
        "        \"]+\", flags=re.UNICODE\n",
        "    )\n",
        "    text = emoji_pattern.sub(\"\", text)\n",
        "\n",
        "    # Rapikan spasi\n",
        "    text = re.sub(r'\\s+', ' ', text).strip()\n",
        "\n",
        "    return text\n",
        "\n",
        "df['clean_text'] = df[text_col].apply(cleaning_text_safe)\n",
        "\n",
        "df = df.dropna(subset=['clean_text'])\n",
        "df = df[df['clean_text'].str.strip() != '']\n",
        "\n",
        "# Tabel Perbandingan\n",
        "tabel_cleaning = df[['id', text_col, 'clean_text']].head(10)\n",
        "display(\n",
        "    tabel_cleaning.style.hide(axis=\"index\")\n",
        ")\n",
        "\n",
        "# Simpan Hasil Cleaning\n",
        "df[['id', text_col, 'clean_text']].to_csv(\"hasil_cleaning.csv\", index=False)\n",
        "\n",
        "print(\"Jumlah data sebelum cleaning (setelah hapus baris nan dan duplikat):\", jumlah_sebelum_cleaning)\n",
        "print(\"Jumlah data sesudah cleaning:\", len(df))\n",
        "print(\"\\nTahap 1 selesai — File 'hasil_cleaning.csv' berhasil disimpan!\")"
