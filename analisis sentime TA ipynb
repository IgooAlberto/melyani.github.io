        "# ===================== DATASET & FUNGSI EVALUASI =====================\n",
        "class TextDataset(Dataset):\n",
        "    \"\"\"Tokenisasi sekali di awal, padding dinamis per batch lewat DataCollatorWithPadding.\"\"\"\n",
        "    def __init__(self, df, max_len):\n",
        "        enc = tokenizer(df[TEXT_COL].tolist(), truncation=True, max_length=max_len)\n",
        "        self.enc, self.y = enc, df[\"y\"].tolist()\n",
        "    def __len__(self): return len(self.y)\n",
        "    def __getitem__(self, i):\n",
        "        item = {k: v[i] for k, v in self.enc.items()}\n",
        "        item[\"labels\"] = self.y[i]\n",
        "        return item\n",
        "\n",
        "collator = DataCollatorWithPadding(tokenizer)\n",
        "\n",
        "def make_loader(df, max_len, batch, shuffle=False, seed=SEED):\n",
        "    g = torch.Generator(); g.manual_seed(seed)\n",
        "    return DataLoader(TextDataset(df, max_len), batch_size=batch, shuffle=shuffle,\n",
        "                      collate_fn=collator, generator=g if shuffle else None)\n",
        "\n",
        "@torch.no_grad()\n",
        "def predict(model, loader):\n",
        "    model.eval()\n",
        "    ys, ps, probs = [], [], []\n",
        "    for batch in loader:\n",
        "        batch = {k: v.to(device) for k, v in batch.items()}\n",
        "        logits = model(**{k: v for k, v in batch.items() if k != \"labels\"}).logits\n",
        "        p = torch.softmax(logits, dim=1)\n",
        "        ys += batch[\"labels\"].cpu().tolist()\n",
        "        ps += p.argmax(1).cpu().tolist()\n",
        "        probs += p.cpu().tolist()\n",
        "    return np.array(ys), np.array(ps), np.array(probs)\n",
        "\n",
        "def metrics(y, p):\n",
        "    pr, rc, f1, _ = precision_recall_fscore_support(y, p, average=\"macro\", zero_division=0)\n",
        "    pc, rcc, f1c, _ = precision_recall_fscore_support(y, p, labels=[0, 1, 2], average=None, zero_division=0)\n",
        "    out = {\"accuracy\": accuracy_score(y, p), \"precision_macro\": pr,\n",
        "           \"recall_macro\": rc, \"f1_macro\": f1}\n",
        "    for i, n in enumerate(CLASS_NAMES):          # precision, recall, F1 per kelas\n",
        "        out[f\"P_{n}\"], out[f\"R_{n}\"], out[f\"F1_{n}\"] = pc[i], rcc[i], f1c[i]\n",
        "    return out\n"
      ]
