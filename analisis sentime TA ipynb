        "# ===================== EVALUASI DATA UJI: Non-ROS vs ROS =====================\n",
        "# Data uji dipakai SEKALI, hanya untuk model terbaik hasil pemilihan pada data validasi.\n",
        "rows, preds_store = [], {}\n",
        "for sc, b in best_per_scenario.items():\n",
        "    model = BertForSequenceClassification.from_pretrained(f\"models/{sc}_best\").to(device)\n",
        "    yt, pt, prob = predict(model, make_loader(df_test, b[\"max_len\"], BATCH_EVAL))\n",
        "    preds_store[sc] = (yt, pt, prob)\n",
        "\n",
        "    print(f\"\\n===== {sc}  (lr={b['lr']}, max_len={b['max_len']}) =====\")\n",
        "    print(classification_report(yt, pt, target_names=CLASS_NAMES, digits=4, zero_division=0))\n",
        "    rows.append({\"Skenario\": sc, \"lr\": b[\"lr\"], \"max_len\": b[\"max_len\"], **metrics(yt, pt)})\n",
        "\n",
        "    cm = confusion_matrix(yt, pt, labels=[0, 1, 2])\n",
        "    plt.figure(figsize=(5.5, 4.5))\n",
        "    sns.heatmap(cm, annot=True, fmt=\"d\", cmap=\"Blues\", xticklabels=CLASS_NAMES, yticklabels=CLASS_NAMES)\n",
        "    plt.title(f\"Confusion Matrix Data Uji - {sc}\"); plt.xlabel(\"Prediksi\"); plt.ylabel(\"Label sebenarnya\")\n",
        "    plt.tight_layout(); plt.show()\n",
        "\n",
        "    out = df_test.copy()\n",
        "    out[\"Prediksi_IndoBERT\"] = [id2label[i] for i in pt]\n",
        "    for i, n in enumerate(CLASS_NAMES): out[f\"Prob_{n}\"] = prob[:, i]\n",
        "    out[\"Prob_Terkuat\"] = prob.max(axis=1)\n",
        "    out.to_csv(f\"hasil_klasifikasi_test_{sc}.csv\", index=False, encoding=\"utf-8-sig\")\n",
        "    del model; torch.cuda.empty_cache()\n",
        "\n",
        "df_compare = pd.DataFrame(rows)\n",
        "df_compare.to_csv(\"perbandingan_NonROS_vs_ROS_test.csv\", index=False)\n",
        "print(\"\\n=== PERBANDINGAN DATA UJI (jawaban Rumusan Masalah) ===\")\n",
        "display(df_compare.round(4))\n"
      ]
