      "source": [
        "# ===================== FUNGSI EKSPERIMEN (dipakai untuk KEDUA skenario) =====================\n",
        "def run_experiment(scenario, lr, max_len):\n",
        "    set_seed(SEED)                     # seed identik di setiap percobaan\n",
        "    df_train = train_dfs[scenario]\n",
        "    train_loader = make_loader(df_train, max_len, BATCH_TRAIN, shuffle=True)\n",
        "    val_loader   = make_loader(df_val,   max_len, BATCH_EVAL)\n",
        "\n",
        "    model = BertForSequenceClassification.from_pretrained(\n",
        "        MODEL_NAME, num_labels=3, id2label=id2label, label2id=label_map,\n",
        "        ignore_mismatched_sizes=True).to(device)\n",
        "    optimizer = torch.optim.AdamW(model.parameters(), lr=lr)\n",
        "\n",
        "    best = {\"accuracy\": -1, \"f1_macro\": -1}; best_state = None; history = []\n",
        "    for epoch in range(1, NUM_EPOCHS + 1):\n",
        "        model.train(); total, tr_y, tr_p = 0.0, [], []\n",
        "        for batch in tqdm(train_loader, desc=f\"{scenario} lr={lr} len={max_len} ep{epoch}\", leave=False):\n",
        "            batch = {k: v.to(device) for k, v in batch.items()}\n",
        "            out = model(**batch)\n",
        "            out.loss.backward(); optimizer.step(); optimizer.zero_grad()\n",
        "            total += out.loss.item()\n",
        "            tr_y += batch[\"labels\"].cpu().tolist(); tr_p += out.logits.argmax(1).cpu().tolist()\n",
        "        yv, pv, _ = predict(model, val_loader)\n",
        "        m = metrics(yv, pv)\n",
        "        history.append({\"epoch\": epoch, \"train_loss\": total/len(train_loader),\n",
        "                        \"train_acc\": accuracy_score(tr_y, tr_p),\n",
        "                        \"val_acc\": m[\"accuracy\"], \"val_f1_macro\": m[\"f1_macro\"]})\n",
        "        print(f\"[{scenario}] lr={lr} len={max_len} ep{epoch}: \"\n",
        "              f\"loss={history[-1]['train_loss']:.4f} train_acc={history[-1]['train_acc']:.4f} \"\n",
        "              f\"val_acc={m['accuracy']:.4f} val_macroF1={m['f1_macro']:.4f}\")\n",
        "        # pilih epoch terbaik: akurasi validasi tertinggi, macro F1 sebagai penentu bila akurasi sama (Bab III)\n",
        "        if (m[\"accuracy\"], m[\"f1_macro\"]) > (best[\"accuracy\"], best[\"f1_macro\"]):\n",
        "            best = {**m, \"epoch\": epoch}\n",
        "            best_state = {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}\n",
        "\n",
        "    model.load_state_dict(best_state)\n",
        "    return model, best, pd.DataFrame(history)\n",
        "\n",
        "# ===================== PENCARIAN HYPERPARAMETER PER SKENARIO =====================\n",
        "os.makedirs(\"models\", exist_ok=True)\n",
        "results, best_per_scenario = [], {}\n",
        "\n",
        "for scenario in SCENARIOS:\n",
        "    for lr in GRID_LR:\n",
        "        for max_len in GRID_MAX_LEN:\n",
        "            model, best, hist = run_experiment(scenario, lr, max_len)\n",
        "            results.append({\"scenario\": scenario, \"lr\": lr, \"max_len\": max_len, **best})\n",
        "            cur = best_per_scenario.get(scenario)\n",
        "            if cur is None or (best[\"accuracy\"], best[\"f1_macro\"]) > (cur[\"accuracy\"], cur[\"f1_macro\"]):\n",
        "                best_per_scenario[scenario] = {\"lr\": lr, \"max_len\": max_len, \"history\": hist, **best}\n",
        "                save_dir = f\"models/{scenario}_best\"          # folder TERPISAH per skenario\n",
        "                model.save_pretrained(save_dir); tokenizer.save_pretrained(save_dir)\n",
        "                json.dump({\"lr\": lr, \"max_len\": max_len, \"epoch\": best[\"epoch\"]},\n",
        "                          open(f\"{save_dir}/config_eksperimen.json\", \"w\"))\n",
        "            del model; torch.cuda.empty_cache()\n",
        "\n",
        "df_grid = pd.DataFrame(results).sort_values([\"scenario\", \"accuracy\", \"f1_macro\"], ascending=[True, False, False])\n",
        "df_grid.to_csv(\"hasil_hyperparameter_validasi.csv\", index=False)\n",
        "display(df_grid.round(4))\n"
      ]
    },
