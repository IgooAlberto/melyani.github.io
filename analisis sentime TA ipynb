        "# ===================== KEKUATAN BUKTI PERBANDINGAN (opsional tapi disarankan) =====================\n",
        "# Data uji hanya 262 komentar (24 negatif), sehingga selisih kecil bisa kebetulan.\n",
        "# Bootstrap memberi interval kepercayaan 95% untuk selisih macro-F1 (ROS - NonROS).\n",
        "yt, p_non, _ = preds_store[\"NonROS\"]\n",
        "_,  p_ros, _ = preds_store[\"ROS\"]\n",
        "rng = np.random.default_rng(SEED); diffs = []\n",
        "for _ in range(2000):\n",
        "    idx = rng.integers(0, len(yt), len(yt))\n",
        "    diffs.append(f1_score(yt[idx], p_ros[idx], average=\"macro\") -\n",
        "                 f1_score(yt[idx], p_non[idx], average=\"macro\"))\n",
        "lo, hi = np.percentile(diffs, [2.5, 97.5])\n",
        "print(f\"Selisih macro-F1 (ROS - NonROS): {np.mean(diffs):+.4f}  | CI95% [{lo:+.4f}, {hi:+.4f}]\")\n",
        "print(\"Jika CI melewati 0, pengaruh ROS belum terbukti signifikan pada data uji ini.\")\n"
      ]
    }
