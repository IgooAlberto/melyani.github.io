        "\n",
        "SCENARIOS = {\n",
        "    \"NonROS\": \"train_80%.csv\",     # data latih asli (tidak seimbang)\n",
        "    \"ROS\":    \"train_ROS80%.csv\",  # data latih setelah Random Over Sampling\n",
        "}\n",
        "VAL_FILE, TEST_FILE = \"val_10%.csv\", \"test_10%.csv\"\n",
