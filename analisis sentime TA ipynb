        "import ast\n",
        "import pandas as pd\n",
        "import re\n",
        "\n",
        "df = pd.read_csv(\"hasil_tokenizing.csv\")\n",
        "# Jika kolom tokens_nlp berbentuk string, ubah jadi list\n",
        "df['tokens_nlp'] = df['tokens_nlp'].apply(lambda x: ast.literal_eval(x) if isinstance(x, str) else x)\n",
        "\n",
        "# Kamus Slang (disesuaikan dengan file yang tersedia)\n",
        "df_slang = pd.read_csv(\"/content/Kamus_Slang_updated.csv\", encoding=\"utf-8-sig\")\n",
        "df_slang.columns = df_slang.columns.str.lower().str.strip()   # kolom: slang, formal\n",
        "slang_dict = dict(zip(df_slang['slang'], df_slang['formal']))\n",
        "\n",
        "# Kamus Tambahan\n",
        "kamus_jawa = {\n",
        "    \"ra\": \"tidak\",\n",
        "    \"ora\": \"tidak\",\n",
        "    \"gak\": \"tidak\",\n",
        "    \"nggak\": \"tidak\",\n",
        "    \"ngerti\": \"paham\",\n",
        "    \"mudeng\": \"paham\",\n",
        "    \"ngeh\": \"paham\",\n",
        "    \"mumet\": \"bingung\",\n",
        "    \"puyeng\": \"pusing\"\n",
        "}\n",
        "kamus_tambahan = {\n",
        "    \"krg\": \"kurang\",\n",
        "    \"blm\": \"belum\",\n",
        "    \"lu\": \"kamu\",\n",
        "    \"bg\": \"bang\",\n",
        "    \"sy\": \"saya\",\n",
        "    \"gk\": \"tidak\",\n",
        "    \"ga\": \"tidak\",\n",
        "    \"gaa\": \"tidak\",\n",
        "    \"gabisa\": \"tidak bisa\",\n",
        "    \"gabisah\": \"tidak bisa\",\n",
        "    \"gabisaa\": \"tidak bisa\"\n",
        "}\n",
        "\n",
        "# Gabung semua kamus\n",
        "combined_dict = {**slang_dict, **kamus_jawa, **kamus_tambahan}\n",
        "\n",
        "# Normalisasi Tawa (wkwk, hehe, xixixi, lol → haha)\n",
        "# Hanya mengubah TOKEN UTUH yang berupa tawa. Pola lama tanpa batas kata mengubah\n",
        "# 'lolos' menjadi 'hahaos' dan 'kolol' menjadi 'kohaha'.\n",
        "POLA_TAWA = re.compile(\n",
        "    r'^(?:(?:ha|he|hi|wk|kw|xi){2,}[hkw]?|(?:w+k+){2,}w*|lo+l+|lmao+)$',\n",
        "    re.IGNORECASE\n",
        ")\n",
        "\n",
        "def normalisasi_tawa(kata):\n",
        "    return 'haha' if POLA_TAWA.match(kata) else kata\n",
        "\n",
        "# Normalisasi Berantai\n",
        "def normalisasi_berantai(kata, kamus):\n",
        "    kata = kata.lower().strip()\t# penting tetap ada, untuk matching di kamus\n",
