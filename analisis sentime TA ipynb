        "# TOKENIZING\n",
        "\n",
        "import pandas as pd\n",
        "import nltk\n",
        "from nltk.tokenize import word_tokenize\n",
        "nltk.download('punkt')\n",
        "nltk.download('punkt_tab') # Add this line to download the missing resource\n",
        "\n",
        "df = pd.read_csv(\"hasil_casefolding.csv\")\n",
        "\n",
        "# FUNGSI TOKENIZING\n",
        "def tokenize_text(teks):\n",
        "    if not isinstance(teks, str) or teks.strip() == \"\":\n",
        "        return []\n",
        "\n",
        "    # Gunakan NLTK word_tokenize\n",
        "    tokens = word_tokenize(teks)\n",
        "\n",
        "    # Bersihkan token kosong atau spasi\n",
        "    tokens = [t for t in tokens if t.strip() != \"\"]\n",
        "    return tokens\n",
        "\n",
        "df['tokens_nlp'] = df['case_folding_text'].apply(tokenize_text)\n",
        "# Tabel Perbandingan\n",
